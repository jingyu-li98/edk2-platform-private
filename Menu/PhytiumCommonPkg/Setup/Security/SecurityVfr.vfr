#include "SecurityNv.h"

formset
  guid      = SECURITY_PAGE_FORMSET_GUID,
  title     = STRING_TOKEN(STR_FORM_SET_TITLE),
  help      = STRING_TOKEN(STR_FORM_SET_TITLE_HELP),
  classguid = gEfiIfrFrontPageGuid,

  form formid = SECURITY_PAGE_FORM_ID,
      title = STRING_TOKEN(STR_FORM_TITLE);

    // Add this invisible text in order to indicate enter Security config form.
    // To trigger the form open action.

    suppressif TRUE;
      text
        help  = STRING_TOKEN (STR_NULL_STRING),
        text  = STRING_TOKEN (STR_NULL_STRING),
        flags = INTERACTIVE,
        key   = FORM_SECURITY_OPEN;
    endif;

     label LABEL_SECURITYPAGE_INFORMATION;

     label LABEL_END;

  endform;

endformset;
