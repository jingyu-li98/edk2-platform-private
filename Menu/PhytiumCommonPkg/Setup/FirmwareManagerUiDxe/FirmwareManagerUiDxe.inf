[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = FirmwareManagerUi
  MODULE_UNI_FILE                = FirmwareManagerUi.uni
  FILE_GUID                      = f46ee234-8ff6-11ee-970f-6f444e4bb8a0
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = FirmwareManagerDriverEntryPoint
  UNLOAD_IMAGE                   = FirmwareManagerDriverUnload
#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = AARCH64
#

[Sources]
  FirmwareManager.c
  FirmwareManager.h
  FirmwareManagerFormGuid.h
  FirmwareManagerUi.vfr
  FirmwareManagerUi.uni
  FirmwareManagerDriver.c

[Packages]
  CryptoPkg/CryptoPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Phytium/PhytiumCommonPkg/PhytiumCommonPkg.dec

[LibraryClasses]
  ArmSmcLib
  BaseLib
  BaseMemoryLib
  BaseCryptLib
  DebugLib
  DxeServicesLib
  FileExplorerLib
  HiiLib
  MemoryAllocationLib
  PrintLib
  PhytiumPowerControlLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib
  UefiRuntimeServicesTableLib

[Guids]
  gEfiHiiPlatformSetupFormsetGuid
  gEfiIfrFrontPageGuid                          ## CONSUMES ## GUID
  gPasswordPrivGuid

[Protocols]
  gEfiDevicePathProtocolGuid
  gEfiHiiConfigAccessProtocolGuid               ## CONSUMES
  gEfiHiiConfigRoutingProtocolGuid
  gSpiNorFlashProtocolGuid

[FeaturePcd]

[Pcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdFlashNvStorageVariableBase64
  gEfiMdeModulePkgTokenSpaceGuid.PcdFlashNvStorageVariableSize

[Depex]
  gEfiHiiConfigRoutingProtocolGuid  AND
  gEfiHiiDatabaseProtocolGuid       AND
  gEfiVariableArchProtocolGuid      AND
  gEfiVariableWriteArchProtocolGuid AND
  gEfiPciIoProtocolGuid
 
