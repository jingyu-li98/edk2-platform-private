#langdef    en-US  "English"
#langdef    zh-Hans  "简体中文"

#string STR_USR_PASSWD                        #language en-US "Set User password"
                                              #language zh-Hans "\wide用户密码设置"
#string STR_USR_PASSWD_HELP                   #language en-US "Input User password. The password length must be 8 to 20 characters and at least two of the following four types of characters: special characters, uppercase letters, lowercase letters, and digits."
                                              #language zh-Hans "\wide用户密码设置\narrow,\wide密码长度\narrow8~20\wide个字符\narrow,\wide并且包含特殊字符\narrow,\wide大写字母\narrow,\wide小写字母和数字中的至少两种"
#string STR_ADMIN_PASSWD                      #language en-US "Set Admin password"
                                              #language zh-Hans "\wide管理员密码设置"
#string STR_ADMIN_PASSWD_HELP                 #language en-US "Input Admin password. The password length must be 8 to 20 characters and at least two of the following four types of characters: special characters, uppercase letters, lowercase letters, and digits. Input empty to clear password."
                                              #language zh-Hans "\wide管理员密码设置\narrow,\wide密码长度\narrow8~20\wide个字符\narrow,\wide并且包含特殊字符\narrow,\wide大写字母\narrow,\wide小写字母和数字中的至少两种\narrow.\wide输入为空\narrow,\wide清除密码\narrow."
#string STR_FORM_PASSWORDCONFIG_TITLE         #language en-US "Password Config"
                                              #language zh-Hans "\wide固件密码设置"
#string STR_PASSWORDCONFIG_MANAGER_HELP       #language en-US "Enter this interface to view and set the password config information"
                                              #language zh-Hans "\wide固件密码设置"
#string STR_NONE                              #language en-US " "
                                              #language zh-Hans " "
#string STR_ENABLE                            #language en-US "Enable"
                                              #language zh-Hans "\wide使能"
#string STR_DISABLE                           #language en-US "Disable"
                                              #language zh-Hans "\wide禁用"
#string STR_USR_PASSWD_ENABLE                 #language en-US "User password"
                                              #language zh-Hans "\wide用户密码"
#string STR_ADMIN_PASSWD_ENABLE               #language en-US "Admin password"
                                              #language zh-Hans "\wide管理员密码"
#string STR_CONFIRM_PASSWD                    #language en-US "Press 'Enter' to save, 'Esc' to ignore."
                                              #language zh-Hans "\wide按\narrowEnter\wide保存\narrow,Esc\wide忽略"
#string STR_USER_ADMIN_SAME                   #language en-US "User Password is the same as Admin Password!"
                                              #language zh-Hans "\wide用户和管理员密码相同"
#string STR_ADMIN_USER_SAME                   #language en-US "Admin Password is the same as User Password!"
                                              #language zh-Hans "\wide管理员和用户密码相同"
#string STR_REINPUT_PASSWD                    #language en-US "Please enter your password again"
                                              #language zh-Hans "\wide请重新输入密码"

#string STR_CLEAN_USER_PASSWORD               #language en-US "Clean User Password"
                                              #language zh-Hans "\wide清除用户密码"
#string STR_CLEAN_USER_PASSWORD_HELP          #language en-US "This will clean the user password"
                                              #language zh-Hans "\wide将清除用户密码"
#string STR_CONFIRM_CLEAN_PASSWD              #language en-US "Press 'Enter' to confirm clean, 'Esc' to ignore."
                                              #language zh-Hans "\wide按\narrowEnter\wide确认清除\narrow,Esc\wide忽略"
#string STR_CLEAN_USER_PASSWORD_WARNING       #language en-US "The user password will also be cleard "
                                              #language zh-Hans "\wide将同步清除用户密码"

