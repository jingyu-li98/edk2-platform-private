#include <IndustryStandard/Acpi.h>
#include <AcpiPlatform.h>

#define EFI_ACPI_SYSTEM_LOCALITIES_ENTRY_COUNT 0x0000000000000008
#define EFI_ACPI_SLIT_OEM_TABLE_ID     SIGNATURE_64('P','H','Y','T','S','L','I','T')

#pragma pack(1)
typedef struct {
  UINT8   Entry[EFI_ACPI_SYSTEM_LOCALITIES_ENTRY_COUNT];
} EFI_ACPI_6_3_NUMBER_OF_SYSTEM_LOCALITIES_STRUCTURE;

typedef struct {
  EFI_ACPI_6_3_SYSTEM_LOCALITY_DISTANCE_INFORMATION_TABLE_HEADER    Header;
  EFI_ACPI_6_3_NUMBER_OF_SYSTEM_LOCALITIES_STRUCTURE                NumSlit[EFI_ACPI_SYSTEM_LOCALITIES_ENTRY_COUNT];
} EFI_ACPI_6_3_SYSTEM_LOCALITY_INFORMATION_TABLE;
#pragma pack()

//
// System Locality Information Table
// Please modify all values in Slit.h only.
//
EFI_ACPI_6_3_SYSTEM_LOCALITY_INFORMATION_TABLE Slit = {
  {
    PHYTIUM_ACPI_HEADER (
      EFI_ACPI_6_3_SYSTEM_LOCALITY_INFORMATION_TABLE_SIGNATURE,
      EFI_ACPI_6_3_SYSTEM_LOCALITY_INFORMATION_TABLE,
      EFI_ACPI_SLIT_OEM_TABLE_ID,
      EFI_ACPI_6_3_SYSTEM_LOCALITY_DISTANCE_INFORMATION_TABLE_REVISION
    ),

    //
    // Beginning of SLIT specific fields
    //
    EFI_ACPI_SYSTEM_LOCALITIES_ENTRY_COUNT,
  },
  {
    {{10, 22, 22, 22, 28, 22, 28, 28}},
    {{22, 10, 22, 22, 22, 28, 28, 28}},
    {{22, 22, 10, 22, 28, 28, 28, 22}},
    {{22, 22, 22, 10, 28, 28, 22, 28}},
    {{28, 22, 28, 28, 10, 22, 22, 22}},
    {{22, 28, 28, 28, 22, 10, 22, 22}},
    {{28, 28, 28, 22, 22, 22, 10, 22}},
    {{28, 28, 22, 28, 22, 22, 22, 10}},

  },
};

//
// Reference the table being generated to prevent the optimizer from removing the
// data structure from the executable
//
VOID* CONST ReferenceAcpiTable = &Slit;
