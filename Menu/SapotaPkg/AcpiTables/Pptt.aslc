#include <IndustryStandard/Acpi.h>
#include <AcpiPlatform.h>

#define FIELD_OFFSET(type, name)       __builtin_offsetof(type, name)
#define EFI_ACPI_PPTT_OEM_TABLE_ID     SIGNATURE_64('P','H','Y','T','P','P','T','T')

// Cache type identifier used to calculate unique cache ID for PPTT
typedef enum {
  L1DataCache = 1,
  L1InstructionCache,
  L2Cache,
  L3Cache,
} PHYTIUM_PPTT_CACHE_TYPE;

#define PHYTIUM_PPTT_CACHE_ID(SocketId, DieId, CoreId, CacheType)        \
    (                                                                    \
      (((SocketId) & 0xF) << 20) | (((DieId) & 0xFF) << 12) |            \
      (((CoreId) & 0xFF) << 4) | ((CacheType) & 0xF)                     \
    )


#pragma pack(1)
typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR                     Core;
  UINT32                                                    Offset[3];
  EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE                         L1ICache;
  EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE                         L1DCache;
  EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE                         L2Cache;
} PHYTIUM_PPTT_CORE;

typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR                     Die;
  UINT32                                                    Offset[1];
  EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE                         L3Cache;
  PHYTIUM_PPTT_CORE                                         Cores[16];
} PHYTIUM_PPTT_DIE;

typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR                     Socket;
  PHYTIUM_PPTT_DIE                                          Dies[2];
} PHYTIUM_PPTT_SOCKET;

typedef struct {
  EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_HEADER   Pptt;
  PHYTIUM_PPTT_SOCKET                                       Socket[2];
} PHYTIUM_PPTT_TABLE;
#pragma pack()

#define PPTT_CORE(SocketId, DieId, CoreId) {                                  \
  {                                                                           \
    EFI_ACPI_6_4_PPTT_TYPE_PROCESSOR,                                         \
    FIELD_OFFSET (PHYTIUM_PPTT_CORE, L1ICache),                               \
    {},                                                                       \
    {                                                                         \
      EFI_ACPI_6_4_PPTT_PACKAGE_NOT_PHYSICAL,                                 \
      EFI_ACPI_6_4_PPTT_PROCESSOR_ID_VALID,                                   \
      EFI_ACPI_6_4_PPTT_PROCESSOR_IS_NOT_THREAD,                              \
      EFI_ACPI_6_4_PPTT_NODE_IS_LEAF,                                         \
      EFI_ACPI_6_4_PPTT_IMPLEMENTATION_IDENTICAL                              \
    },                                                                        \
    FIELD_OFFSET (PHYTIUM_PPTT_TABLE,                                         \
                  Socket[SocketId].Dies[DieId]), /* Parent */                 \
    32 * SocketId + 16 * (DieId) + (CoreId),      /* AcpiProcessorId */       \
    3,                                      /* NumberOfPrivateResources*/     \
  }, {                                                                        \
    FIELD_OFFSET (PHYTIUM_PPTT_TABLE,                                         \
                  Socket[SocketId].Dies[DieId].Cores[CoreId].L1ICache),       \
    FIELD_OFFSET (PHYTIUM_PPTT_TABLE,                                         \
                  Socket[SocketId].Dies[DieId].Cores[CoreId].L1DCache),       \
    FIELD_OFFSET (PHYTIUM_PPTT_TABLE,                                         \
                  Socket[SocketId].Dies[DieId].Cores[CoreId].L2Cache),        \
  }, {                                                                        \
    EFI_ACPI_6_4_PPTT_TYPE_CACHE,                                             \
    sizeof (EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE),                               \
    {},                                                                       \
    {                                                                         \
      1,          /* SizePropertyValid */                                     \
      1,          /* NumberOfSetsValid */                                     \
      1,          /* AssociativityValid */                                    \
      1,          /* AllocationTypeValid */                                   \
      1,          /* CacheTypeValid */                                        \
      1,          /* WritePolicyValid */                                      \
      1,          /* LineSizeValid */                                         \
      1           /* CacheIdValid */                                          \
    },                                                                        \
    FIELD_OFFSET (PHYTIUM_PPTT_TABLE,                                         \
                  Socket[SocketId].Dies[DieId].Cores[CoreId].L2Cache),        \
    SIZE_64KB,    /* Size */                                                  \
    256,          /* NumberOfSets */                                          \
    4,            /* Associativity */                                         \
    {                                                                         \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_ALLOCATION_READ,                          \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_CACHE_TYPE_INSTRUCTION,                   \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK,                  \
    },                                                                        \
    64,            /* LineSize */                                             \
    PHYTIUM_PPTT_CACHE_ID(SocketId, DieId, CoreId, L1InstructionCache)        \
  }, {                                                                        \
    EFI_ACPI_6_4_PPTT_TYPE_CACHE,                                             \
    sizeof (EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE),                               \
    {},                                                                       \
    {                                                                         \
      1,          /* SizePropertyValid */                                     \
      1,          /* NumberOfSetsValid */                                     \
      1,          /* AssociativityValid */                                    \
      1,          /* AllocationTypeValid */                                   \
      1,          /* CacheTypeValid */                                        \
      1,          /* WritePolicyValid */                                      \
      1,          /* LineSizeValid */                                         \
      1           /* CacheIdValid */                                          \
    },                                                                        \
    FIELD_OFFSET (PHYTIUM_PPTT_TABLE,                                         \
                  Socket[SocketId].Dies[DieId].Cores[CoreId].L2Cache),        \
    SIZE_64KB,    /* Size */                                                  \
    256,          /* NumberOfSets */                                          \
    4,            /* Associativity */                                         \
    {                                                                         \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,                    \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_CACHE_TYPE_DATA,                          \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK                   \
    },                                                                        \
    64,            /* LineSize */                                             \
    PHYTIUM_PPTT_CACHE_ID(SocketId, DieId, CoreId, L1DataCache)               \
  }, {                                                                        \
    EFI_ACPI_6_4_PPTT_TYPE_CACHE,                                             \
    sizeof (EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE),                               \
    {},                                                                       \
    {                                                                         \
      1,          /* SizePropertyValid */                                     \
      1,          /* NumberOfSetsValid */                                     \
      1,          /* AssociativityValid */                                    \
      1,          /* AllocationTypeValid */                                   \
      1,          /* CacheTypeValid */                                        \
      1,          /* WritePolicyValid */                                      \
      1,          /* LineSizeValid */                                         \
      1           /* CacheIdValid */                                          \
    },                                                                        \
    0,                                                                        \
    SIZE_512KB,   /* Size */                                                  \
    1024,         /* NumberOfSets */                                          \
    8,            /* Associativity */                                         \
    {                                                                         \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,                    \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,                       \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK                   \
    },                                                                        \
    64,            /* LineSize */                                             \
    PHYTIUM_PPTT_CACHE_ID(SocketId, DieId, CoreId, L2Cache)                   \
  }                                                                           \
}

#define PPTT_DIE(SocketId, DieId) {                                           \
  {                                                                           \
    EFI_ACPI_6_4_PPTT_TYPE_PROCESSOR,                                         \
    FIELD_OFFSET (PHYTIUM_PPTT_DIE, L3Cache),                                 \
    {},                                                                       \
    {                                                                         \
      EFI_ACPI_6_4_PPTT_PACKAGE_NOT_PHYSICAL,                                 \
      EFI_ACPI_6_4_PPTT_PROCESSOR_ID_INVALID,                                 \
      EFI_ACPI_6_4_PPTT_PROCESSOR_IS_NOT_THREAD,                              \
      EFI_ACPI_6_4_PPTT_NODE_IS_NOT_LEAF,                                     \
      EFI_ACPI_6_4_PPTT_IMPLEMENTATION_IDENTICAL                              \
    },                                                                        \
    FIELD_OFFSET (PHYTIUM_PPTT_TABLE, Socket[SocketId]), /* Parent */         \
    0,                                        /* AcpiProcessorId */           \
    1,                                        /* NumberOfPrivateResources */  \
  }, {                                                                        \
    FIELD_OFFSET (PHYTIUM_PPTT_TABLE, Socket[SocketId].Dies[DieId].L3Cache),  \
  }, {                                                                        \
    EFI_ACPI_6_4_PPTT_TYPE_CACHE,                                             \
    sizeof (EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE),                               \
    {},                                                                       \
    {                                                                         \
      1,          /* SizePropertyValid */                                     \
      1,          /* NumberOfSetsValid */                                     \
      1,          /* AssociativityValid */                                    \
      1,          /* AllocationTypeValid */                                   \
      1,          /* CacheTypeValid */                                        \
      1,          /* WritePolicyValid */                                      \
      1,          /* LineSizeValid */                                         \
      1           /* CacheIdValid */                                          \
    },                                                                        \
    0,            /* NextLevelOfCache */                                      \
    SIZE_8MB,     /* Size */                                                  \
    8192,         /* NumberOfSets */                                          \
    16,           /* Associativity */                                         \
    {                                                                         \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE,                    \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED,                       \
      EFI_ACPI_6_4_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK                   \
    },                                                                        \
    64,            /* LineSize */                                             \
    PHYTIUM_PPTT_CACHE_ID(SocketId, DieId, 0, L3Cache)                        \
  }, {                                                                        \
    PPTT_CORE(SocketId, DieId, 0),                                            \
    PPTT_CORE(SocketId, DieId, 1),                                            \
    PPTT_CORE(SocketId, DieId, 2),                                            \
    PPTT_CORE(SocketId, DieId, 3),                                            \
    PPTT_CORE(SocketId, DieId, 4),                                            \
    PPTT_CORE(SocketId, DieId, 5),                                            \
    PPTT_CORE(SocketId, DieId, 6),                                            \
    PPTT_CORE(SocketId, DieId, 7),                                            \
    PPTT_CORE(SocketId, DieId, 8),                                            \
    PPTT_CORE(SocketId, DieId, 9),                                            \
    PPTT_CORE(SocketId, DieId, 0xA),                                          \
    PPTT_CORE(SocketId, DieId, 0xB),                                          \
    PPTT_CORE(SocketId, DieId, 0xC),                                          \
    PPTT_CORE(SocketId, DieId, 0xD),                                          \
    PPTT_CORE(SocketId, DieId, 0xE),                                          \
    PPTT_CORE(SocketId, DieId, 0xF),                                          \
  }                                                                           \
}

#define PPTT_SOCKET(SocketId) {                                               \
  {                                                                           \
    EFI_ACPI_6_4_PPTT_TYPE_PROCESSOR,                                         \
    sizeof (EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR),                           \
    {},                                                                       \
    {                                                                         \
      EFI_ACPI_6_4_PPTT_PACKAGE_PHYSICAL,                                     \
      EFI_ACPI_6_4_PPTT_PROCESSOR_ID_INVALID,                                 \
      EFI_ACPI_6_4_PPTT_PROCESSOR_IS_NOT_THREAD,                              \
      EFI_ACPI_6_4_PPTT_NODE_IS_NOT_LEAF,                                     \
      EFI_ACPI_6_4_PPTT_IMPLEMENTATION_IDENTICAL                              \
    },                                                                        \
    0, /* Parent */                                                           \
    0, /* AcpiProcessorId */                                                  \
    0, /* NumberOfPrivateResources */                                         \
  }, {                                                                        \
    PPTT_DIE (SocketId, 0),                                                   \
    PPTT_DIE (SocketId, 1),                                                   \
  }                                                                           \
}

STATIC PHYTIUM_PPTT_TABLE mPhytiumPpttTable = {
  {
    PHYTIUM_ACPI_HEADER (
      EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_STRUCTURE_SIGNATURE,
      PHYTIUM_PPTT_TABLE,
      EFI_ACPI_PPTT_OEM_TABLE_ID,
      EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_REVISION),
  },
  {
    PPTT_SOCKET(0),
    PPTT_SOCKET(1)
  }
};

//
// Reference the table being generated to prevent the optimizer from removing the
// data structure from the executable
//
VOID* CONST ReferenceAcpiTable = &mPhytiumPpttTable;
