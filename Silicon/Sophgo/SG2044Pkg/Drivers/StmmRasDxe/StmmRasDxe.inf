[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = SophgoStmmRasHandle
  FILE_GUID                      = 5f9c9674-25df-11ed-a9ab-17e1776bcd62
  MODULE_TYPE                    = MM_STANDALONE
  VERSION_STRING                 = 1.0
  PI_SPECIFICATION_VERSION       = 0x00010032
  ENTRY_POINT                    = PhytiumStmmRasHandleInitialize

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = AARCH64
#

[Sources]
  Bert.c
  Bert.h
  Einj.c
  Einj.h
  Ghes.c
  Ghes.h
  PhytiumStmmRas.c
  Ras.c
  Ras.h

[Packages]
  ArmPkg/ArmPkg.dec
  ArmPlatformPkg/ArmPlatformPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Silicon/Sophgo/SG2044Pkg/SG2044Pkg.dec
  StandaloneMmPkg/StandaloneMmPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  IpmiBaseLib
  IpmiCommandLib
  MemoryAllocationLib
  PcdLib
  SiliconLib
  StandaloneMmDriverEntryPoint
  TimeBaseLib

[Protocols]
  gEfiSophgoStmmRasProtocolGuid
  gSpiNorFlashProtocolGuid

[Pcd]
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemoryBase
  gPhytiumPlatformTokenSpaceGuid.PcdBertRegionOffset
  gPhytiumPlatformTokenSpaceGuid.PcdEinjRegionOffset
  gPhytiumPlatformTokenSpaceGuid.PcdHestRegionOffset
  gPhytiumPlatformTokenSpaceGuid.PcdBertRegionSize
  gPhytiumPlatformTokenSpaceGuid.PcdRasEinjTriggerErrorAddress
