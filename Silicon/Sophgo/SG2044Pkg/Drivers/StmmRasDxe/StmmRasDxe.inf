  gPhytiumPlatformTokenSpaceGuid.PcdTimerTickReadRegister
  gPhytiumPlatformTokenSpaceGuid.PcdRasBmcCperEnable
  gPhytiumPlatformTokenSpaceGuid.PcdRasFatalErrorRecord
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemoryIsoRecord
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemFatalUceIsoStrategyEnable
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemFatalUceIsoStrategyResetClean
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemFatalUceIsoStrategyMethod
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemFatalUceIsoStrategyCount
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemNonFatalUceIsoStrategyEnable
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemNonFatalUceIsoStrategyResetClean
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemNonFatalUceIsoStrategyMethod
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemNonFatalUceIsoStrategyCount
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemCeIsoStrategyEnable
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemCeIsoStrategyResetClean
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemCeIsoStrategyMethod
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemCeIsoStrategyCount
  gPhytiumPlatformTokenSpaceGuid.PcdRasCpuFatalIsoStrategyEnable
  gPhytiumPlatformTokenSpaceGuid.PcdRasCpuFatalIsoStrategyResetClean
  gPhytiumPlatformTokenSpaceGuid.PcdRasCpuFatalIsoStrategyMethod
  gPhytiumPlatformTokenSpaceGuid.PcdRasCpuFatalIsoStrategyRecord
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemCeReportStrategyEnable
  gPhytiumPlatformTokenSpaceGuid.PcdRasMemCeReportStrategyCount
  gPhytiumPlatformTokenSpaceGuid.PcdRasCpuCeReportStrategyEnable
  gPhytiumPlatformTokenSpaceGuid.PcdRasCpuCeReportStrategyCount
  gPhytiumPlatformTokenSpaceGuid.PcdRasPcieCeReportStrategyEnable
  gPhytiumPlatformTokenSpaceGuid.PcdRasPcieCeReportStrategyCount
