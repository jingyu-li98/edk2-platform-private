[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = SpiDxe
  FILE_GUID                      = 2344AE6D-FD83-4DBD-B0BE-5D36240B06BB
  MODULE_TYPE                    = DXE_RUNTIME_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SpiEntryPoint

[Sources.common]
  Spi.c
  Spi.h

[Packages]
  MdePkg/MdePkg.dec
  UefiCpuPkg/UefiCpuPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  Silicon/Sophgo/Sophgo.dec

[LibraryClasses]
  IoLib
  DebugLib
  MemoryAllocationLib
  NorFlashInfoLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib
  UefiRuntimeLib

[Protocols]
  gSophgoSpiMasterProtocolGuid
  gFdtClientProtocolGuid

[Pcd]
  gSophgoTokenSpaceGuid.PcdSPIFMC0Base                            ## CONSUMES
  gSophgoTokenSpaceGuid.PcdSPIFMC1Base                            ## CONSUMES
  gSophgoTokenSpaceGuid.PcdSpifmcDmmrEnable                       ## CONSUMES

[Depex]
  gFdtClientProtocolGuid
