[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PasswordHashLib
  FILE_GUID                      = 12345678-1234-1234-1234-123456789012
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = PasswordHashLib

[Sources]
  PasswordHashLib.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib
  BaseLib

[Protocols]
  gEfiHash2ProtocolGuid         ## CONSUMES

[Guids]
  gEfiHashAlgorithmSha256Guid  ## CONSUMES

[BuildOptions]
  MSFT:*_*_*_CC_FLAGS = /W4
  GCC:*_*_*_CC_FLAGS = -Wall -Wextra 